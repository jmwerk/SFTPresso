{
  "name": "sftpresso",
  "displayName": "SFTPresso",
  "description": "Sync files over SFTP, FTP/FTPS, or SSH from VS Code — upload on save, browse a remote explorer, diff and compare folders. Actively maintained fork of vscode-sftp.",
  "version": "1.41.0",
  "publisher": "jmwerk",
  "author": "Joe Werkheiser <j.m.werkheiser@gmail.com> (https://github.com/jmwerk)",
  "engines": {
    "vscode": "^1.138.0",
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/jmwerk/SFTPresso/issues"
  },
  "qna": "https://github.com/jmwerk/SFTPresso/discussions/categories/q-a",
  "homepage": "https://jmwerk.github.io/SFTPresso/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmwerk/SFTPresso.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "sftp",
    "ssh",
    "ftps",
    "sync",
    "remote",
    "deploy",
    "upload",
    "download",
    "file transfer",
    "remote development",
    "remote explorer"
  ],
  "activationEvents": [
    "workspaceContains:.vscode/sftp.json"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "main": "./dist/extension",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sftp",
          "title": "SFTP",
          "icon": "resources/remote-explorer.svg"
        }
      ]
    },
    "views": {
      "sftp": [
        {
          "id": "remoteExplorer",
          "name": "%view.remoteExplorer.name%",
          "icon": "resources/remote-explorer.svg",
          "contextualTitle": "SFTP",
          "when": "sftp.enabled"
        },
        {
          "id": "sftpTransfers",
          "name": "%view.sftpTransfers.name%",
          "icon": "resources/transfers.svg",
          "contextualTitle": "SFTP",
          "when": "sftp.enabled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sftpTransfers",
        "contents": "%viewsWelcome.sftpTransfers.contents%"
      }
    ],
    "colors": [
      {
        "id": "sftp.remoteFileForeground",
        "description": "%color.sftp.remoteFileForeground.description%",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange",
          "highContrastLight": "charts.orange"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "sftp.debug": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.sftp.debug.description%"
        },
        "sftp.printDebugLog": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.sftp.printDebugLog.description%",
          "deprecationMessage": "%configuration.sftp.printDebugLog.deprecationMessage%",
          "markdownDeprecationMessage": "%configuration.sftp.printDebugLog.markdownDeprecationMessage%"
        },
        "sftp.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.sftp.downloadWhenOpenInRemoteExplorer.description%"
        },
        "sftp.openRemoteFilesReadOnly": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.sftp.openRemoteFilesReadOnly.description%"
        }
      }
    },
    "commands": [
      {
        "command": "sftp.config",
        "title": "%sftp.config.title%",
        "category": "SFTP"
      },
      {
        "command": "sftp.setProfile",
        "title": "%sftp.setProfile.title%",
        "category": "SFTP"
      },
      {
        "command": "sftp.openConnectInTerminal",
