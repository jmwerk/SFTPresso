          "when": "view == remoteExplorer && viewItem =~ /^(root|folder)\\b/"
        },
        {
          "command": "sftp.upload.folder",
          "group": "3_trans@1",
          "alt": "sftp.forceUpload",
          "when": "sftp.enabled && viewItem =~ /^(root|folder)\\b/"
        },
        {
          "command": "sftp.remoteExplorer.uploadHere",
          "group": "3_trans@2",
          "when": "view == remoteExplorer && viewItem =~ /^(root|folder)\\b/"
        },
        {
          "command": "sftp.upload.file",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
