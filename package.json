      ],
      "explorer/context": [
        {
          "command": "sftp.revealInRemoteExplorer",
          "group": "navigation@20",
          "when": "sftp.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "sftp.diff",
          "group": "3_compare",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.compareFolders",
          "group": "3_compare",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.localToRemote",
          "group": "sftp.sync@1",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.remoteToLocal",
          "group": "sftp.sync@2",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.bothDirections",
          "group": "sftp.sync@3",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.file",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.folder",
          "group": "sftp.trans@1",
          "alt": "sftp.forceUpload",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder && sftp.hasProfiles"
        },
        {
          "command": "sftp.upload.folder.to.allProfiles",
          "group": "sftp.trans@1",
          "alt": "sftp.forceUpload.to.allProfiles",
          "when": "sftp.enabled && explorerResourceIsFolder && sftp.hasProfiles"
        },
        {
          "command": "sftp.download.file",
          "group": "sftp.trans@2",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.download.folder",
          "group": "sftp.trans@2",
          "alt": "sftp.forceDownload",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.addToIgnore",
          "group": "7_modification",
          "when": "sftp.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "sftp.copyRemotePath",
          "group": "sftp.trans@3",
          "when": "sftp.enabled && !explorerResourceIsRoot"
        }
      ],
      "editor/context": [
        {
          "command": "sftp.upload.file",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file && sftp.hasProfiles"
        },
        {
          "command": "sftp.download.file",
          "group": "sftp.trans@2",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.diff",
          "group": "3_compare",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.copyRemotePath",
          "group": "sftp.trans@3",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "sftp.enabled && resourceScheme == remote"
        },
        {
          "command": "sftp.remoteExplorer.diffWithLocal",
          "group": "3_compare",
          "when": "sftp.enabled && resourceScheme == remote && !isInDiffEditor"
        }
      ],
      "editor/title": [
        {
