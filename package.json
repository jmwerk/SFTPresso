        },
        {
          "command": "sftp.remoteExplorer.filter",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.remoteExplorer.clearFilter",
          "when": "sftp.enabled && sftp.remoteExplorer.filterActive"
        },
        {
          "command": "sftp.cancelAllTransfer",
          "when": "sftp.enabled"
        },
        {
