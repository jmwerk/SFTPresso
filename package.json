  },
  "scripts": {
    "postinstall": "patch-package",
    "vscode:prepublish": "npm run typecheck && npm run compile",
    "compile": "node esbuild.mjs --production",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,js}\" \"__mocks__/**/*.js\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,js}\" \"__mocks__/**/*.js\" \"*.mjs\"",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "test": "jest",
    "test:integration": "jest --config test/integration/jest.config.js",
    "test:integration:up": "sh test/integration/openssh/prepare-keys.sh && docker compose -f test/integration/docker-compose.yml up -d --build --wait",
    "test:integration:down": "docker compose -f test/integration/docker-compose.yml down -v",
    "package": "vsce package",
    "pub:debug": "rm -rf _debug && mkdir _debug && vsce package --out _debug/sftp-debug.vsix && cd _debug && git init && git commit --allow-empty -m 'update debug package' && git checkout -b debug-pacakge && cp ../INSTALL_DEBUG.md README.md  && git add . && git commit -am 'update debug package' && git push git@github.com:jmwerk/SFTPresso.git debug-pacakge --force"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.138.0",
    "@vscode/l10n-dev": "0.0.35",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "memfs": "4.80.0",
    "patch-package": "^8.0.1",
    "prettier": "3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "async": "^3.2.6",
    "basic-ftp": "^6.2.6",
    "fs-extra": "^11.4.1",
    "ignore": "^7.0.14",
    "joi": "^18.3.2",
    "jsonc-parser": "^3.3.1",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^11.5.3",
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0",
    "tmp": "^0.2.1",
    "upath": "^3.0.8",
    "vscode-uri": "^3.2.0"
  },
  "jest": {
    "verbose": true,
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testMatch": [
      "<rootDir>/test/**/*.spec.js",
      "<rootDir>/src/**/__tests__/*.ts"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "@vscode/l10n-dev": {
      "glob": "^13.0.6"
    }
  }
}
