        "scheme": "remote",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "sftpresso.gettingStarted",
        "title": "%walkthrough.sftpresso.gettingStarted.title%",
